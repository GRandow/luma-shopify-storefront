# Shopify Storefront API
# Leave the URL empty (or as below) to use Shopify's public mock.shop sandbox: no store, no token.
# For a real store use https://<shop>.myshopify.com/api/2026-07/graphql.json and a public
# Storefront access token (Headless channel or a custom app with unauthenticated_read_* scopes).
VITE_SHOPIFY_STOREFRONT_API_URL=https://mock.shop/api
VITE_SHOPIFY_STOREFRONT_TOKEN=

# "true" sends "Secure checkout" to Shopify's hosted checkout (cart.checkoutUrl).
# Keep it false with mock.shop, whose checkout URL is only a placeholder.
VITE_HOSTED_CHECKOUT=false

# Development stores can't remove their password page and Shopify's checkout redirects to it
# until the password is entered once. Set it here to show a hint next to the checkout button.
VITE_STORE_PASSWORD_HINT=

# Demo authentication only (DummyJSON). Customer accounts will move to the Customer Account API.
VITE_AUTH_API_URL=https://dummyjson.com
